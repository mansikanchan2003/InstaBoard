# Copy to backend/.env and fill in. Never commit real credentials.

# development | test | production
APP_ENV=development

# SQLAlchemy URL (psycopg 3 driver). Example for the local helper cluster or docker compose:
#   postgresql+psycopg://instaboard:<password>@localhost:5544/instaboard
DATABASE_URL=postgresql+psycopg://instaboard:change-me-local-only@localhost:5544/instaboard

# Separate database used by pytest (it is migrated and wiped by the test suite).
TEST_DATABASE_URL=postgresql+psycopg://instaboard:change-me-local-only@localhost:5544/instaboard_test

# Comma-separated browser origins allowed by CORS (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Exposes /docs and /openapi.json. Disable outside local development.
ENABLE_DOCS=true

# --- Local PostgreSQL helper (python -m scripts.local_postgres) / docker compose ---
LOCAL_PG_PORT=5544
LOCAL_PG_USER=instaboard
LOCAL_PG_PASSWORD=change-me-local-only

# --- Authentication & sessions (Phase 4) ---
# Signs CSRF tokens. REQUIRED in production (>= 32 random chars; the app refuses to start without it).
# Generate one locally:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left empty in development, an ephemeral per-process key is used (CSRF tokens change on every restart).
SECRET_KEY=

# Session cookie. COOKIE_SECURE must be true in production (HTTPS only).
SESSION_COOKIE_NAME=instaboard_session
COOKIE_SECURE=false
# lax | strict
COOKIE_SAMESITE=lax
# Leave empty for a host-only cookie (recommended).
COOKIE_DOMAIN=

# Sliding idle timeout and absolute lifetime of a session.
SESSION_IDLE_MINUTES=120
SESSION_MAX_AGE_HOURS=24

# Public URL of the frontend, used to build one-time invitation links.
FRONTEND_URL=http://localhost:5173
INVITATION_TTL_HOURS=72

# Rate limits (in-process; use a shared store when running several workers).
LOGIN_ATTEMPTS_PER_WINDOW=5
LOGIN_WINDOW_SECONDS=900
AUTH_REQUESTS_PER_MINUTE_PER_IP=30
MIN_PASSWORD_LENGTH=12

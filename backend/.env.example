# Copy to backend/.env and fill in. Never commit real credentials.

# development | test | production
APP_ENV=development

# SQLAlchemy URL (psycopg 3 driver). Example for the local helper cluster or docker compose:
#   postgresql+psycopg://instaboard:<password>@localhost:5544/instaboard
DATABASE_URL=postgresql+psycopg://instaboard:change-me-local-only@localhost:5544/instaboard

# Separate database used by pytest (it is migrated and wiped by the test suite).
TEST_DATABASE_URL=postgresql+psycopg://instaboard:change-me-local-only@localhost:5544/instaboard_test

# Comma-separated browser origins allowed by CORS (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Exposes /docs and /openapi.json. Disable outside local development.
ENABLE_DOCS=true

# --- Local PostgreSQL helper (python -m scripts.local_postgres) / docker compose ---
LOCAL_PG_PORT=5544
LOCAL_PG_USER=instaboard
LOCAL_PG_PASSWORD=change-me-local-only

# --- Authentication & sessions (Phase 4) ---
# Signs CSRF tokens. REQUIRED in production (>= 32 random chars; the app refuses to start without it).
# Generate one locally:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left empty in development, an ephemeral per-process key is used (CSRF tokens change on every restart).
SECRET_KEY=

# Session cookie. COOKIE_SECURE must be true in production (HTTPS only).
SESSION_COOKIE_NAME=instaboard_session
COOKIE_SECURE=false
# lax | strict
COOKIE_SAMESITE=lax
# Leave empty for a host-only cookie (recommended).
COOKIE_DOMAIN=

# Sliding idle timeout and absolute lifetime of a session.
SESSION_IDLE_MINUTES=120
SESSION_MAX_AGE_HOURS=24

# Public URL of the frontend, used to build one-time invitation links.
FRONTEND_URL=http://localhost:5173
INVITATION_TTL_HOURS=72

# Rate limits (in-process; use a shared store when running several workers).
LOGIN_ATTEMPTS_PER_WINDOW=5
LOGIN_WINDOW_SECONDS=900
AUTH_REQUESTS_PER_MINUTE_PER_IP=30
MIN_PASSWORD_LENGTH=12

# --- Instagram API with Instagram Login (Phase 5) ---
# Leave ALL of these empty to keep the integration disabled (demo data keeps working).
# Setting only some of them is a startup error. Values come from:
#   Meta App Dashboard > your app > Instagram > API setup with Instagram login > 3. Set up Instagram business login
#   > Business login settings  (these are the *Instagram* app ID/secret, NOT the Meta app ID/secret).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must exactly match a "Valid OAuth Redirect URI" in Business login settings (check for an added trailing slash).
# Local development:  http://localhost:8100/api/v1/integrations/instagram/callback   (https:// is required elsewhere)
INSTAGRAM_REDIRECT_URI=
# Graph API version used for graph.instagram.com calls. Verify the current version in Meta's changelog, e.g. v26.0
INSTAGRAM_GRAPH_API_VERSION=
# Read-only scopes (comma-separated). instagram_business_basic is required. Add instagram_business_manage_comments
# only if you need comments (Meta grants reply/delete rights with it, although InstaBoard only reads).
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_insights
# Fernet key that encrypts access tokens at rest. Generate one (keep it secret, back it up — losing it means every
# account must reconnect):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_TOKEN_KEY_VERSION=1
# During key rotation: retired keys as "1:<old-key>" (comma-separated) until all tokens were re-encrypted.
INSTAGRAM_TOKEN_PREVIOUS_KEYS=
# Optional tuning (defaults shown).
# INSTAGRAM_HTTP_TIMEOUT_SECONDS=10
# INSTAGRAM_HTTP_MAX_RETRIES=2
# INSTAGRAM_SYNC_MAX_MEDIA=50
# INSTAGRAM_SYNC_MAX_MEDIA_INSIGHTS=25
# INSTAGRAM_SYNC_MAX_COMMENT_MEDIA=10
# INSTAGRAM_SYNC_COOLDOWN_SECONDS=60

# Data source for the frontend services layer. Copy to .env.local to override (never commit secrets).
#   demo -> bundled, typed demo data (default; makes no network requests)
#   api  -> the FastAPI + PostgreSQL backend in ../backend (same as `npm run dev:api`)
VITE_DATA_SOURCE=demo
VITE_API_BASE_URL=http://localhost:8100/api/v1

# InstaBoard production environment — copy to deploy/.env.production and fill in. NEVER commit the copy.
# Used both for Compose interpolation (--env-file) and as the backend containers' env_file.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Database / Redis (private network; not published) ---
POSTGRES_USER=instaboard
POSTGRES_PASSWORD=
POSTGRES_DB=instaboard
REDIS_PASSWORD=

# --- Public URLs (https only in production) ---
# The browser origin of the web app. The API is served on the same origin under /api.
FRONTEND_URL=https://instaboard.example.com
CORS_ORIGINS=https://instaboard.example.com
WEB_PORT=8080
WEB_BIND=127.0.0.1

# --- Security (required; the API refuses to start in production otherwise) ---
SECRET_KEY=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
ENABLE_DOCS=false
LOG_LEVEL=INFO
MAX_REQUEST_BYTES=1048576
WEB_CONCURRENCY=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Instagram API with Instagram Login (leave all empty to keep the integration disabled) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_GRAPH_API_VERSION=
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_TOKEN_KEY_VERSION=1
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_insights

# --- Background sync ---
SYNC_SCHEDULER_ENABLED=true
INSTAGRAM_SYNC_INTERVAL_MINUTES=360
INSTAGRAM_WORKER_CONCURRENCY=2
INSTAGRAM_JOB_MAX_RETRIES=3

# --- AI (AI_PROVIDER=none keeps AI disabled) ---
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_MONTHLY_TOKEN_LIMIT=500000
AI_DAILY_REQUEST_LIMIT=500
AI_SCHEDULED_INSIGHTS_ENABLED=false
